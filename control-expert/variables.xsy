<comment>Vibration X, mm/s</comment>
</variables>
<variables name="rVibY" typeName="REAL">
<comment>Vibration Y, mm/s</comment>
</variables>
<variables name="rVibZ" typeName="REAL">
<comment>Vibration Z, mm/s</comment>
</variables>
