<comment>The MPB10's four floats: temperature, X, Y, Z</comment>
</variables>
<variables name="iFloat" typeName="INT">
<comment>Loop index (01_MPB10_Decode)</comment>
</variables>
<variables name="iPow" typeName="INT">
<comment>Loop index (01_MPB10_Decode)</comment>
</variables>
<variables name="iExpo" typeName="INT">
