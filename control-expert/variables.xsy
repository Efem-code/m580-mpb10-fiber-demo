</variables>
<variables name="iB3" typeName="INT">
<comment>Float byte (01_MPB10_Decode)</comment>
</variables>
<variables name="rTemperature" typeName="REAL">
<comment>Temperature, degC</comment>
</variables>
<variables name="rVibWarnLimit" typeName="REAL">
<comment>PLC warning limit, mm/s (ISO 10816-3 B/C)</comment>
<variableInit value="2.8"></variableInit>
</variables>
<variables name="rVibAlarmLimit" typeName="REAL">
<comment>PLC alarm limit, mm/s (ISO 10816-3 C/D)</comment>
<variableInit value="4.5"></variableInit>
</variables>
<variables name="rTempWarnLimit" typeName="REAL">
<comment>PLC temperature warning, degC</comment>
<variableInit value="70.0"></variableInit>
</variables>
<variables name="xVibWarning" typeName="BOOL">
<comment>Vibration warning</comment>
</variables>
<variables name="xVibAlarm" typeName="BOOL">
<comment>Vibration alarm</comment>
</variables>
<variables name="xShock" typeName="BOOL">
