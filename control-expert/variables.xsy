</variables>
<variables name="xTempWarning" typeName="BOOL">
<comment>Temperature warning</comment>
</variables>
<variables name="xSensorCommAlarm" typeName="BOOL">
<comment>Sensor data not reaching the PLC</comment>
</variables>
