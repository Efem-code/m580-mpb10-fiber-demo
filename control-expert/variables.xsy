<contentHeader name="M580 MPB10 demo" version="0.0.000" dateTime="date_and_time#2026-11-05-07:47:41"></contentHeader>
<dataBlock>
<variables name="aDash" typeName="ARRAY[0..31] OF INT" topologicalAddress="%MW1000">
<comment>Status block read by the dashboard</comment>
</variables>
<variables name="aCmd" typeName="ARRAY[0..4] OF INT" topologicalAddress="%MW1100">
<comment>Command block written by the dashboard (only when drive control is on)</comment>
</variables>
<variables name="aSIG300_In" typeName="ARRAY[0..63] OF BYTE">
<comment>Copy of the SIG300 input assembly (00_IO_Map)</comment>
</variables>
<variables name="xSIG300_Health" typeName="BOOL">
<comment>SIG300 EtherNet/IP connection healthy</comment>
<variableInit value="FALSE"></variableInit>
</variables>
<variables name="xMPB_PortActive" typeName="BOOL">
<comment>Port S1 has a working IO-Link device</comment>
<variableInit value="FALSE"></variableInit>
</variables>
<variables name="xMPB_DataOK" typeName="BOOL">
<comment>MPB10 values are valid this scan</comment>
<variableInit value="FALSE"></variableInit>
</variables>
<variables name="iPD_Ofs" typeName="INT">
<comment>Offset of port S1 process data in aSIG300_In (6, from the SIG300 EDS)</comment>
<variableInit value="6"></variableInit>
</variables>
